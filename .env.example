# Copy to .env for local development. On Vercel, set these under
# Settings -> Environment Variables instead. .env is gitignored: never commit
# real tokens or passwords.

# ---------------------------------------------------------------------------
# Mail — Hostinger Mail API (preferred)
# ---------------------------------------------------------------------------
# Create in hPanel -> Emails -> your mailbox -> API tokens. The token is shown
# once. It is revocable on its own, without changing the mailbox password.
HOSTINGER_API_KEY=your-mail-api-token

# The mailbox that sends. Optional: with the token alone the app calls
# GET /api/v1/me once and caches the result. Setting it explicitly saves that
# round trip on a cold start.
HOSTINGER_MAILBOX_ID=AC0000000000000000000000000000

# ---------------------------------------------------------------------------
# Mail — SMTP fallback
# ---------------------------------------------------------------------------
# Used only when HOSTINGER_API_KEY is unset. Its one advantage over the API is
# Reply-To support, which the API has no field for.
#
# NOTE: this must be the mailbox address exactly as it exists in hPanel.
EMAIL_USER=suport@folafemzglobal.com
EMAIL_PASSWORD=your-mailbox-password

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465

# ---------------------------------------------------------------------------
# Where enquiries are delivered. Defaults to EMAIL_USER when unset.
# ---------------------------------------------------------------------------
EMAIL_TO=suport@folafemzglobal.com

# ---------------------------------------------------------------------------
# Canonical origin, used for canonical tags, sitemap.xml and robots.txt.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://folafemzglobal.com

# ---------------------------------------------------------------------------
# "Ask me AI" assistant (/api/ask)
# ---------------------------------------------------------------------------
# Set ONE of the two keys below. Both are free tiers with no card and no
# billing: when the daily quota runs out the assistant goes quiet and points
# visitors at WhatsApp. Neither can cost anyone money.
#
# Set neither and the widget says it is not switched on yet — safe to deploy,
# nothing else on the site is affected.

# Preferred: Cerebras. Open-source models (Llama), and the free tier is metered
# in tokens rather than requests — roughly 1M/day, which at ~1,500 tokens a
# question is several hundred questions. Sign up at https://cloud.cerebras.ai
# -> API Keys. Self-serve, live immediately.
CEREBRAS_API_KEY=csk-your-free-key

# Backup: Google Gemini. Not an open-source model, but the most dependable free
# tier available and no card required. https://aistudio.google.com/apikey
# GOOGLE_GENERATIVE_AI_API_KEY=your-free-key

# Optional overrides. Model IDs change more often than anything else here, so
# they are not pinned in code — check the provider's console if one 404s.
# AI_PROVIDER=cerebras          # force one when both keys are present
# AI_MODEL=llama-3.3-70b        # default per provider, see lib/model.ts
